# ─── Server-only secrets (NEVER exposed to the client bundle) ──────────────
# Google Gemini API key. Used only by the Express server for résumé-based
# question generation and answer scoring. Leave blank to run with the
# heuristic fallback (no AI).
GEMINI_API_KEY=

# Gemini model to use for text generation + scoring (optional).
GEMINI_MODEL=gemini-2.5-flash

# Mimic Guide (the in-app help assistant) reuses GEMINI_API_KEY and GEMINI_MODEL
# above — no separate key or provider. With no key set it still works, answering
# from a built-in canned knowledge base. Speech-to-text uses the browser's native
# Web Speech API (no key, no cost). Text-to-speech uses the browser voice when
# one is installed for the language, and otherwise falls back to server-side
# Gemini Live synthesis (POST /api/help/tts — reuses GEMINI_API_KEY and
# GEMINI_LIVE_MODEL below) so all 55 guide languages are spoken correctly.

# ─── Voice Track (real-time) ───────────────────────────────────────────────
# The Voice Track streams mic audio to the backend over a WebSocket, which
# relays to the Gemini Live native-audio API. The key stays server-only; nothing
# audio-related is exposed to the client bundle/APK. Live model (optional):
#   gemini-3.1-flash-live-preview (default; ~740ms to first audio)
#   gemini-2.5-flash-native-audio-preview-09-2025 (legacy; ~2.8s + thinking)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Port the API server listens on (optional; Vite proxies /api here).
PORT=8787

# ─── Production / Google Cloud (see docs/DEPLOYMENT.md) — server-only ──────
# Prefer Vertex AI (service-account/IAM auth) over an API key on production.
# When USE_VERTEX=true the server should auth via Application Default
# Credentials (the Cloud Run service account) — no key string on any device.
USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1

# Client → API base URL for the native (Capacitor/Play Store) build ONLY.
# In web/dev the Vite proxy handles /api, so leave this blank there.
# This is a public base URL, NOT a secret (the key stays on the server).
VITE_API_BASE=

# ─── AI Avatar Screening (Tavus) — server-side keys only ───────────────────
# All of these stay on the SERVER and are proxied via /api/avatar/* — none are
# exposed in the client bundle/APK. The Tavus key is entered at runtime in the
# recruiter Settings UI (also never compiled into the bundle).
#
# Deepgram Nova-3 (live speech-to-text). The browser gets a short-lived token
# minted from this key via POST /api/avatar/deepgram/token.
DEEPGRAM_API_KEY=
# Hume AI (voice prosody / emotion). Batch jobs are proxied via /api/avatar/hume/*.
HUME_API_KEY=
# Extra hostnames (comma-separated suffixes) the replica-preview cache may fetch
# from, on top of the built-in Tavus/CDN list (see server/routes/faceCache.ts).
# FACE_CACHE_HOSTS=
# Gemini for the ATS reasoning layer reuses GEMINI_API_KEY above (proxied via
# /api/avatar/gemini-generate). No separate key needed.
# AWS Rekognition (facial analysis) — proxied via /api/avatar/analyze-face.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# Tavus key fallback for CANDIDATE Video Avatar interviews. Normally the key is
# applied from the Setup page ("Apply to Candidate Interviews") and stored in the
# server's data store; set this only to provide a deployment-wide fallback.
# TAVUS_API_KEY=

# ─── Authentication & access control — see docs/AUTH.md ───────────────────
# Firebase Email/Password auth on the SHARED project `talbotiq-9cc4e` (same project
# the Flutter app uses). The role is NOT decided by the server — it lives on the
# Firestore doc `users/{uid}.role` (chosen at sign-up, read live by the client and
# read per-request by the server via the Admin SDK). No custom claims, no demo mode.
#
# SERVER Firebase Admin (verifies ID tokens + reads users/{uid}.role from Firestore).
# Provide a service account for talbotiq-9cc4e: Firebase console → Project settings →
# Service accounts → "Generate new private key". Split it across these three vars;
# keep FIREBASE_PRIVATE_KEY on ONE line with its newlines escaped as \n.
# If these are blank the app still boots, but auth-guarded /api endpoints return 503.
FIREBASE_PROJECT_ID=talbotiq-9cc4e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively leave the three above blank and use Application Default
# Credentials (a key-file path, or the ambient service account on Cloud Run):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# OPTIONAL admin overlay (server-only, NEVER taken from the client): a recruiter
# whose email is listed here also sees unclaimed legacy sessions. Leave blank to
# disable. This does NOT grant the recruiter role — that comes from users/{uid}.role.
ADMIN_EMAILS=

# ─── Firebase Web config (compiled into the client bundle) — PUBLIC, NOT secret
# These identify the shared project `talbotiq-9cc4e`; they are safe to embed.
VITE_FIREBASE_API_KEY=AIzaSyAF1O1SoXKv5iZ1RMaXQurVYwRSoT4ynqY
VITE_FIREBASE_AUTH_DOMAIN=talbotiq-9cc4e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talbotiq-9cc4e
VITE_FIREBASE_STORAGE_BUCKET=talbotiq-9cc4e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=473028554722
VITE_FIREBASE_APP_ID=1:473028554722:web:152baa837fe77c7fb713bb
